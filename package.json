{
  "name": "english-reading-desk",
  "productName": "Reading Desk",
  "version": "1.1.1",
  "private": true,
  "description": "本機英文閱讀與語境學習桌面應用程式",
  "author": "Reading Desk",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write src electron shared tests scripts/*.cjs *.json vite.config.ts .vscode/*.json",
    "dev": "node scripts/dev.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && node scripts/subscription-smoke.cjs",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "pack:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "jose": "^6.2.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "com.readingdesk.desktop",
    "productName": "Reading Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
